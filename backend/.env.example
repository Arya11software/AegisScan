# =============================================================
# AegisScan Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# =============================================================

# ------ Server ------
# Port the Express backend listens on.
# Render sets this automatically; set to 3001 for local dev.
PORT=3001

# ------ Target ------
# Absolute or relative path to the authorized World Monitor target source.
# Relative paths are resolved from process.cwd() (i.e., the backend/ directory).
#
# Local development example (target sits inside the repo):
TARGET_ROOT=./target/worldmonitor
#
# Render (if target is bundled inside the repo at backend/target/worldmonitor):
# TARGET_ROOT=./target/worldmonitor
#
# Render (if target is at a custom absolute path — unlikely on ephemeral FS):
# TARGET_ROOT=/opt/render/project/src/backend/target/worldmonitor

# ------ CORS ------
# Full URL of the deployed Vercel frontend (no trailing slash).
# Example: https://aegisscan.vercel.app
FRONTEND_URL=http://localhost:5173

# ------ AI Analysis (optional) ------
# Set ONE of these to enable LLM-powered AI analysis.
# Leave blank to use the built-in rule-based analyzer.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
